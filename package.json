{
  "name": "cell-ui",
  "version": "0.1.0",
  "description": "Excel-like spreadsheet UI for the web: Excel clipboard interop, Excel keyboard shortcuts, cell styling, extensible via plugins.",
  "type": "module",
  "main": "./dist/cell-ui.js",
  "module": "./dist/cell-ui.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cell-ui.iife.js",
  "jsdelivr": "./dist/cell-ui.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cell-ui.js",
      "default": "./dist/cell-ui.iife.js"
    },
    "./style.css": "./dist/cell-ui.css",
    "./iife": "./dist/cell-ui.iife.js"
  },
  "sideEffects": ["./dist/cell-ui.css", "./src/styles.css", "./src/index.ts"],
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0",
    "playwright": "^1.48.0"
  },
  "license": "MIT"
}
